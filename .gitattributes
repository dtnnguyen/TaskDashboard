# history.jsonl is append-only: when two machines both add lines, keep both sides instead of conflicting.
history.jsonl merge=union
history.archive.jsonl merge=union

# Same line endings on macOS, Linux and Windows.
*.md      text eol=lf
*.jsonl   text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
td        text eol=lf
